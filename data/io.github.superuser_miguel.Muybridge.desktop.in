[Desktop Entry]
Name=Muybridge
GenericName=Frame Extractor
Comment=Take still frames out of video at any rate you choose
Type=Application
Exec=muybridge %U
Icon=@app_id@
Terminal=false
Categories=AudioVideo;Video;Utility;GTK;
Keywords=frames;stills;ffmpeg;video;extract;screenshot;snapshot;sequence;
StartupNotify=true
StartupWMClass=@app_id@
MimeType=video/mp4;video/x-m4v;video/x-matroska;video/quicktime;video/webm;video/x-msvideo;video/x-ms-wmv;video/x-flv;video/mpeg;video/mp2t;video/ogg;video/3gpp;
